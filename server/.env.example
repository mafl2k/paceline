# Copy to .env (never commit .env). Set PACELINE_HOST to your own host; the rest is optional.
# Docker Compose interpolates $: write a literal $ in a password as $$ (or avoid it).
# Empty or commented out means unset: the server applies its own default.
# The v1 captain login is not needed any more; it only serves as the operator login when ADMIN_* is
# unset. A password starting with change-me stops the start.
#UPLOAD_USER=captain
#UPLOAD_PASS=change-me-to-a-long-random-password

# Recording caps in MB: one upload / all recordings together (defaults shown)
#LOG_MAX_FILE_MB=20
#LOG_MAX_TOTAL_MB=2000

# Base of mailed links. Empty: https://<PACELINE_HOST>
#PUBLIC_URL=

# SMTP server. Mail is on only with SMTP_HOST, MAIL_FROM and PUBLIC_URL (or PACELINE_HOST) all set;
# otherwise: no mail, no registration
#SMTP_HOST=

# Empty: 587 (465 with SMTP_SECURE=tls)
#SMTP_PORT=

# starttls (default) or tls
#SMTP_SECURE=

# SMTP login (never logged)
#SMTP_USER=

# SMTP password; avoid `$`
#SMTP_PASS=

# Sender, e.g. Paceline <paceline@example.org>. Needed for mail, together with SMTP_HOST
#MAIL_FROM=

# Mail cap per day. Empty: 200
#MAIL_MAX_PER_DAY=

# open (default) or closed
#REGISTRATION=

# Default time zone for new clubs. Empty: Europe/Berlin
#PACELINE_TZ=

# Operator name and address shown on /privacy
#PRIVACY_CONTACT=Example Operator <privacy@example.org>

# Where the notice of every Remove a rider goes (an address). Empty: the first address in PRIVACY_CONTACT
#OPERATOR_EMAIL=operator@example.org

# Where the data is processed, one line of plain text shown on /privacy (at most 500 characters).
# Empty: the page tells readers to ask the contact. Example:
#PRIVACY_WHERE=The plan server and its mail server run on example servers in Germany (EU).

# Operator login. Empty: the UPLOAD_* pair
#ADMIN_USER=

# Operator password. Long and random (openssl rand -base64 24; at least 20 characters), avoid `$`:
# the login throttle does not stop someone who guesses right
#ADMIN_PASS=

# Proxies in front of the server. Empty: 1
#TRUSTED_PROXY_HOPS=

# Key of the private clubs' rider-code hashes (HMAC), at least 32 characters. Generate one with
#   openssl rand -base64 48
# Empty: private clubs are off. Keep it out of the data folder and backups. Changing it ends every
# club's code.
#CODE_SECRET=

# Most active clubs; registration and the first click on a club link refuse a new one beyond it; an operator restore is not counted. Empty: 50
#MAX_CIRCLES=

# Recordings per club in MB. Empty: 300
#LOG_MAX_CIRCLE_MB=

# Delete recordings after this many days. Empty: 90, 0 keeps all
#LOG_RETENTION_DAYS=

# How long your backups of the whole server (outside Paceline) are kept, in months; /privacy says it. Empty: 6
#BACKUP_RETENTION_MONTHS=

# Oldest mod version without a notice (older ones still work). Empty: any
#MOD_MIN_VERSION=

# Text for older mods. Empty: Please update Paceline to {min} or newer.
#MOD_NOTICE=

# Traefik names (defaults shown; uncomment and adapt to your setup)
#PACELINE_HOST=ttt.example.org   # set your own
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
#TRAEFIK_NETWORK=traefik
