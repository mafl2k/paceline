# Copy to .env (never commit .env) and choose a long password.
# Docker Compose interpolates $: write a literal $ in the password as $$ (or avoid it).
UPLOAD_USER=captain
UPLOAD_PASS=change-me-to-a-long-random-password

# Recording caps in MB: one upload / all recordings together (defaults shown)
#LOG_MAX_FILE_MB=20
#LOG_MAX_TOTAL_MB=2000

# Traefik names (defaults shown; uncomment and adapt to your setup)
#PACELINE_HOST=ttt.mafl.net
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
#TRAEFIK_NETWORK=traefik
